# --- Backend (FastAPI) ---
PORT=8000
ENV=development

# --- Razorpay (test mode) ---
# Razorpay Dashboard > Settings > API Keys (Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- LLM provider (reasoning / explanation / copilot text generation ONLY —
# never used by the policy engine; see AGENTS.md §3 and §9) ---
# Business logic must not be coupled to a specific provider. Set LLM_PROVIDER
# to whichever backend is in use; only the corresponding key needs a value.
LLM_PROVIDER=anthropic   # one of: anthropic | openai | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Persistence (the backend REFUSES TO START unless you choose one) ---
# postgres = durable. Needs DATABASE_URL below and a migrated schema:
#     python -m backend.app.db.migrate upgrade        (or set REVORA_DB_AUTO_MIGRATE=1 for local dev)
# memory   = NOT durable. Every record is lost when the process exits. Demos and tests only; refused when ENV=production.
# There is no fallback: a wrong or unreachable database is an error, never a silent switch to memory.
# First time: copy this file to .env (gitignored) and edit it. backend/app/config.py loads the repo-root .env, and
# run.bat checks it (python -m backend.app.preflight) before starting anything. The placeholder password is refused.
REVORA_STORAGE=postgres
# Keep the real value in .env (gitignored), never in source control. The sample credentials are rejected on purpose.
DATABASE_URL=postgresql://revora_app:CHANGE_ME@localhost:5432/revora
# Optional: run everything inside this schema instead of the connection's default (lower-case letters, digits, _).
# REVORA_DB_SCHEMA=
# REVORA_DB_POOL_SIZE=10
# REVORA_DB_AUTO_MIGRATE=0
# Seconds before an execution that reserved an attempt but never completed (process died) is closed as an
# interrupted, still-counted attempt. Must exceed the slowest legitimate provider call.
# REVORA_RESERVATION_TIMEOUT_SECONDS=900

# --- Tests ---
# Database tests start a throwaway PostgreSQL from the binaries on this machine. To use a server of your own
# instead, point this at it; tests only ever create and drop schemas named revora_test_* inside it.
# REVORA_TEST_DATABASE_URL=postgresql://postgres@localhost:5432/postgres
# Make "no PostgreSQL available" a failure instead of a skip (use in CI):
# REVORA_REQUIRE_POSTGRES=1

# --- Frontend (Next.js, once created) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
