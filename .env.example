# --- Backend (FastAPI) ---
PORT=8000
ENV=development

# --- Razorpay (test mode) ---
# Razorpay Dashboard > Settings > API Keys (Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- LLM provider (reasoning / explanation / copilot text generation ONLY —
# never used by the policy engine; see AGENTS.md §3 and §9) ---
# Business logic must not be coupled to a specific provider. Set LLM_PROVIDER
# to whichever backend is in use; only the corresponding key needs a value.
LLM_PROVIDER=anthropic   # one of: anthropic | openai | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Database ---
# Not yet wired into main.py — current build holds pipeline state in-process
# (see PROJECT_STRUCTURE.md, P1). Leave unset for the current demo build.
DATABASE_URL=postgresql://user:password@localhost:5432/revora

# --- Frontend (Next.js, once created) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
