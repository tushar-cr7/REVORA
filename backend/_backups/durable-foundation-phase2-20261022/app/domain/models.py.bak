from dataclasses import dataclass, field
from datetime import datetime, timezone
from enum import Enum
from typing import Any, Dict, FrozenSet, List, Optional
import uuid


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def new_id(prefix: str, length: int = 10) -> str:
    return f"{prefix}_{uuid.uuid4().hex[:length]}"


class Action(str, Enum):
    RETRY = "retry"
    PAYMENT_LINK = "payment_link"
    REMINDER = "reminder"
    ESCALATE = "escalate"
    SUPPRESS = "suppress"


class AuditEventType(str, Enum):
    DECISION_CREATED = "DECISION_CREATED"
    POLICY_EVALUATED = "POLICY_EVALUATED"
    ACTION_AUTHORIZED = "ACTION_AUTHORIZED"
    ACTION_BLOCKED = "ACTION_BLOCKED"
    EXECUTION_STARTED = "EXECUTION_STARTED"
    EXECUTION_SUCCEEDED = "EXECUTION_SUCCEEDED"
    EXECUTION_FAILED = "EXECUTION_FAILED"
    ESCALATION_CREATED = "ESCALATION_CREATED"
    SUPPRESSION_CREATED = "SUPPRESSION_CREATED"


@dataclass
class Transaction:
    transaction_id: str
    leak_id: str
    merchant_id: str
    customer_id: str
    amount: float
    leak_type: str
    payment_method: str
    failure_code: str
    prior_successful_payments: int
    ltv_bucket: str
    # Safety-critical figures are Optional on purpose: a value the source did not
    # supply stays None (and fails closed at execution) rather than becoming 0.
    retries_so_far: Optional[int]
    hours_since_event: Optional[int]
    age_days: Optional[int]
    event_time: str
    merchant_segment: str
    payment_id: Optional[str] = None
    visit_count: Optional[int] = 0
    reached_payment_page: Optional[bool] = False
    consecutive_failures: Optional[int] = 0
    subscription_age_days: Optional[int] = 0
    contacts_today: int = 0
    model_recovery_prob: Optional[float] = None
    run_id: Optional[str] = None  # the scan run this record belongs to

    def to_dict(self) -> Dict[str, Any]:
        return {
            "run_id": self.run_id,
            "transaction_id": self.transaction_id,
            "leak_id": self.leak_id,
            "merchant_id": self.merchant_id,
            "customer_id": self.customer_id,
            "amount": self.amount,
            "leak_type": self.leak_type,
            "payment_method": self.payment_method,
            "failure_code": self.failure_code,
            "prior_successful_payments": self.prior_successful_payments,
            "ltv_bucket": self.ltv_bucket,
            "retries_so_far": self.retries_so_far,
            "hours_since_event": self.hours_since_event,
            "age_days": self.age_days,
            "event_time": self.event_time,
            "merchant_segment": self.merchant_segment,
            "payment_id": self.payment_id,
            "visit_count": self.visit_count,
            "reached_payment_page": self.reached_payment_page,
            "consecutive_failures": self.consecutive_failures,
            "subscription_age_days": self.subscription_age_days,
            "contacts_today": self.contacts_today,
            "model_recovery_prob": self.model_recovery_prob,
        }


@dataclass
class Decision:
    decision_id: str
    leak_id: str
    transaction_id: str
    candidates_evaluated: List[Dict[str, Any]]
    ai_proposed_action: str
    ai_proposed_ev: float
    ai_proposed_probability: float
    policy_allowed: bool
    policy_reason: str
    final_action: str
    created_at: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())
    run_id: Optional[str] = None
    case_id: Optional[str] = None
    policy_version: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return {
            "run_id": self.run_id,
            "case_id": self.case_id,
            "policy_version": self.policy_version,
            "decision_id": self.decision_id,
            "leak_id": self.leak_id,
            "transaction_id": self.transaction_id,
            "candidates_evaluated": self.candidates_evaluated,
            "ai_proposed_action": self.ai_proposed_action,
            "ai_proposed_ev": self.ai_proposed_ev,
            "ai_proposed_probability": self.ai_proposed_probability,
            "policy_allowed": self.policy_allowed,
            "policy_reason": self.policy_reason,
            "final_action": self.final_action,
            "created_at": self.created_at,
        }


@dataclass
class Intervention:
    intervention_id: str
    decision_id: str
    leak_id: str
    transaction_id: str
    customer_id: str
    merchant_id: str
    amount: float
    ai_proposed_action: str
    policy_allowed: bool
    policy_reason: str
    final_action: str
    provider: str
    status: str
    recovered: bool
    recovered_amount: float
    timestamp: str
    execution_probability_used: Optional[float] = None
    idempotency_key: Optional[str] = None
    run_id: Optional[str] = None
    case_id: Optional[str] = None
    attempt_id: Optional[str] = None
    # "simulation" for SimulationProvider: nothing was sent to a payment network.
    execution_mode: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return {
            "run_id": self.run_id,
            "case_id": self.case_id,
            "attempt_id": self.attempt_id,
            "execution_mode": self.execution_mode,
            "intervention_id": self.intervention_id,
            "decision_id": self.decision_id,
            "leak_id": self.leak_id,
            "transaction_id": self.transaction_id,
            "customer_id": self.customer_id,
            "merchant_id": self.merchant_id,
            "amount": self.amount,
            "ai_proposed_action": self.ai_proposed_action,
            "policy_allowed": self.policy_allowed,
            "policy_reason": self.policy_reason,
            "final_action": self.final_action,
            "provider": self.provider,
            "status": self.status,
            "recovered": self.recovered,
            "recovered_amount": self.recovered_amount,
            "timestamp": self.timestamp,
            "execution_probability_used": self.execution_probability_used,
            "idempotency_key": self.idempotency_key,
        }


@dataclass
class AuditEvent:
    event_id: str
    merchant_id: str
    transaction_id: str
    leak_id: str
    decision_id: Optional[str]
    intervention_id: Optional[str]
    timestamp: str
    event_type: str
    action: str
    policy_result: Dict[str, Any]
    policy_version: str = "1.0.0"
    model_version: str = "1.0.0"
    provider: str = "SimulationProvider"
    outcome: Optional[Dict[str, Any]] = None
    correlation_id: Optional[str] = None
    idempotency_key: Optional[str] = None
    run_id: Optional[str] = None
    case_id: Optional[str] = None
    attempt_id: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return {
            "run_id": self.run_id,
            "case_id": self.case_id,
            "attempt_id": self.attempt_id,
            "event_id": self.event_id,
            "merchant_id": self.merchant_id,
            "transaction_id": self.transaction_id,
            "leak_id": self.leak_id,
            "decision_id": self.decision_id,
            "intervention_id": self.intervention_id,
            "timestamp": self.timestamp,
            "event_type": self.event_type,
            "action": self.action,
            "policy_result": self.policy_result,
            "policy_version": self.policy_version,
            "model_version": self.model_version,
            "provider": self.provider,
            "outcome": self.outcome,
            "correlation_id": self.correlation_id,
            "idempotency_key": self.idempotency_key,
        }


# ──────────────────────────────────────────────────────────────────────────
# Recovery lifecycle: scan runs, recovery cases, the attempt ledger and
# idempotency records. A case is the unit of recovery (one per transaction per
# scan run); an attempt is one entry in that case's execution ledger.
# ──────────────────────────────────────────────────────────────────────────

# Sentinel for "do not scope by run" in repository queries.
ALL_RUNS = "all"

RECOVERY_ACTIONS = (Action.RETRY.value, Action.PAYMENT_LINK.value, Action.REMINDER.value)
CUSTOMER_CONTACT_ACTIONS = (Action.REMINDER.value, Action.PAYMENT_LINK.value)


class CaseState(str, Enum):
    OPEN = "open"                                    # scanned, no decision yet
    AUTHORIZED = "authorized"                        # decision exists and policy allowed it
    BLOCKED = "blocked"                              # policy refused the proposal; only the safe alternative is executable
    EXECUTING = "executing"                          # an attempt is reserved and in flight
    RECOVERED = "recovered"                          # a simulated attempt recovered the amount (terminal)
    ATTEMPTED_NO_RECOVERY = "attempted_no_recovery"  # an attempt ran and did not recover; may be retried if policy allows
    SUPPRESSED = "suppressed"                        # deliberate no-action executed (terminal)
    ESCALATED = "escalated"                          # handed to the merchant; NOT a recovery (terminal)


TERMINAL_CASE_STATES: FrozenSet[CaseState] = frozenset(
    {CaseState.RECOVERED, CaseState.SUPPRESSED, CaseState.ESCALATED}
)

# Cases in these states have recorded outcomes (or an attempt in flight), so
# re-analysis must not replace their decision.
FROZEN_CASE_STATES: FrozenSet[CaseState] = TERMINAL_CASE_STATES | {CaseState.EXECUTING}

# States from which a new execution attempt may be requested.
EXECUTABLE_CASE_STATES: FrozenSet[CaseState] = frozenset(
    {CaseState.AUTHORIZED, CaseState.BLOCKED, CaseState.ATTEMPTED_NO_RECOVERY}
)

CASE_TRANSITIONS: Dict[CaseState, FrozenSet[CaseState]] = {
    CaseState.OPEN: frozenset({CaseState.AUTHORIZED, CaseState.BLOCKED}),
    CaseState.AUTHORIZED: frozenset({CaseState.BLOCKED, CaseState.EXECUTING}),
    CaseState.BLOCKED: frozenset({CaseState.AUTHORIZED, CaseState.EXECUTING}),
    CaseState.EXECUTING: frozenset({
        CaseState.RECOVERED,
        CaseState.ATTEMPTED_NO_RECOVERY,
        CaseState.SUPPRESSED,
        CaseState.ESCALATED,
    }),
    CaseState.ATTEMPTED_NO_RECOVERY: frozenset({CaseState.AUTHORIZED, CaseState.BLOCKED, CaseState.EXECUTING}),
    CaseState.RECOVERED: frozenset(),
    CaseState.SUPPRESSED: frozenset(),
    CaseState.ESCALATED: frozenset(),
}


class InvalidCaseTransition(ValueError):
    """Raised for a lifecycle move the state machine does not allow."""


class AttemptStatus(str, Enum):
    RESERVED = "reserved"    # authorized and recorded; the provider has not returned yet
    COMPLETED = "completed"  # provider returned a valid result (recovered or not)
    FAILED = "failed"        # provider raised, or returned an unusable result
    DENIED = "denied"        # policy refused at execution time; never reached the provider


# A denied attempt consumed nothing. Reserved/completed/failed all count against
# retry and contact limits (a failed provider call may still have reached the customer).
COUNTED_ATTEMPT_STATUSES: FrozenSet[AttemptStatus] = frozenset(
    {AttemptStatus.RESERVED, AttemptStatus.COMPLETED, AttemptStatus.FAILED}
)


@dataclass
class ScanRun:
    run_id: str
    merchant_id: str
    source_fingerprint: str      # hash of (merchant, n_total, seed): identical source data => same run
    n_total: int
    seed: int
    created_at: str
    last_scanned_at: str
    scan_count: int = 1
    transaction_count: int = 0
    total_at_risk: float = 0.0
    status: str = "active"       # "active" | "superseded"
    superseded_at: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return {
            "run_id": self.run_id,
            "merchant_id": self.merchant_id,
            "source_fingerprint": self.source_fingerprint,
            "n_total": self.n_total,
            "seed": self.seed,
            "created_at": self.created_at,
            "last_scanned_at": self.last_scanned_at,
            "scan_count": self.scan_count,
            "transaction_count": self.transaction_count,
            "total_at_risk": self.total_at_risk,
            "status": self.status,
            "superseded_at": self.superseded_at,
        }


@dataclass
class RecoveryCase:
    case_id: str
    run_id: str
    merchant_id: str
    transaction_id: str
    leak_id: str
    customer_id: str
    leak_type: str
    amount: float
    state: CaseState = CaseState.OPEN
    decision_id: Optional[str] = None
    authorized_action: Optional[str] = None      # the decision's policy-authorized final action
    authorization: Optional[Dict[str, Any]] = None
    policy_version: Optional[str] = None
    attempt_count: int = 0                       # counted attempts (reserved / completed / failed)
    active_attempt_id: Optional[str] = None
    recovered_attempt_id: Optional[str] = None
    recovered_amount: float = 0.0
    outcome_status: Optional[str] = None         # status of the latest completed intervention
    blocked_reason: Optional[str] = None
    safe_alternative: Optional[str] = None
    history: List[Dict[str, Any]] = field(default_factory=list)
    created_at: str = field(default_factory=utc_now_iso)
    updated_at: str = field(default_factory=utc_now_iso)

    def transition(self, to: CaseState, reason: str, at: Optional[str] = None) -> None:
        """Move to `to` or raise. The only way a case changes state."""
        to = CaseState(to)
        if to not in CASE_TRANSITIONS[self.state]:
            raise InvalidCaseTransition(
                f"Case {self.case_id}: {self.state.value} -> {to.value} is not a valid transition."
            )
        at = at or utc_now_iso()
        self.history.append({"from": self.state.value, "to": to.value, "at": at, "reason": reason})
        self.state = to
        self.updated_at = at

    def to_dict(self) -> Dict[str, Any]:
        return {
            "case_id": self.case_id,
            "run_id": self.run_id,
            "merchant_id": self.merchant_id,
            "transaction_id": self.transaction_id,
            "leak_id": self.leak_id,
            "customer_id": self.customer_id,
            "leak_type": self.leak_type,
            "amount": self.amount,
            "state": self.state.value,
            "decision_id": self.decision_id,
            "authorized_action": self.authorized_action,
            "authorization": self.authorization,
            "policy_version": self.policy_version,
            "attempt_count": self.attempt_count,
            "active_attempt_id": self.active_attempt_id,
            "recovered_attempt_id": self.recovered_attempt_id,
            "recovered_amount": self.recovered_amount,
            "outcome_status": self.outcome_status,
            "blocked_reason": self.blocked_reason,
            "safe_alternative": self.safe_alternative,
            "history": list(self.history),
            "created_at": self.created_at,
            "updated_at": self.updated_at,
        }


@dataclass
class ExecutionAttempt:
    attempt_id: str
    case_id: str
    run_id: str
    merchant_id: str
    transaction_id: str
    customer_id: str
    sequence: int                          # position in the case ledger, denied requests included
    attempt_number: Optional[int]          # position among COUNTED attempts; None for a denied request
    requested_action: str                  # the case's authorized action when the request arrived
    final_action: Optional[str]            # action actually authorized for execution; None if denied
    decision_id: Optional[str]
    authorization: Dict[str, Any]          # execution-time policy verdict + the inputs it was computed from
    status: AttemptStatus
    idempotency_key: Optional[str]
    request_fingerprint: str
    provider: str
    execution_mode: str
    created_at: str                        # reserved (or denied) at
    completed_at: Optional[str] = None
    intervention_id: Optional[str] = None
    outcome_status: Optional[str] = None
    recovered: bool = False
    recovered_amount: float = 0.0
    failure_reason: Optional[str] = None   # provider failure text or policy denial reason

    def to_dict(self) -> Dict[str, Any]:
        return {
            "attempt_id": self.attempt_id,
            "case_id": self.case_id,
            "run_id": self.run_id,
            "merchant_id": self.merchant_id,
            "transaction_id": self.transaction_id,
            "customer_id": self.customer_id,
            "sequence": self.sequence,
            "attempt_number": self.attempt_number,
            "requested_action": self.requested_action,
            "final_action": self.final_action,
            "decision_id": self.decision_id,
            "authorization": self.authorization,
            "status": self.status.value,
            "idempotency_key": self.idempotency_key,
            "request_fingerprint": self.request_fingerprint,
            "provider": self.provider,
            "execution_mode": self.execution_mode,
            "created_at": self.created_at,
            "completed_at": self.completed_at,
            "intervention_id": self.intervention_id,
            "outcome_status": self.outcome_status,
            "recovered": self.recovered,
            "recovered_amount": self.recovered_amount,
            "failure_reason": self.failure_reason,
        }


@dataclass
class IdempotencyRecord:
    """Scoped to (merchant_id, operation, key) and bound to one request fingerprint."""
    merchant_id: str
    operation: str
    key: str
    request_fingerprint: str
    case_id: str
    attempt_id: str
    status: str = "in_progress"            # "in_progress" | "completed"
    http_status: Optional[int] = None
    response: Optional[Dict[str, Any]] = None
    created_at: str = field(default_factory=utc_now_iso)
    completed_at: Optional[str] = None

    @property
    def scope(self) -> tuple:
        return (self.merchant_id, self.operation, self.key)
